DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_airbnb?schema=public"
JWT_SECRET="super-secret-jwt-key-change-me-in-production"
PORT=4000

# LiveKit Configuration
# These can be found in your LiveKit Cloud dashboard or local config
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_WS_URL="ws://localhost:7880"

# Redis Config (optional if not running locally, but we'll use a local instance for presence)
REDIS_URL="redis://localhost:6379"
